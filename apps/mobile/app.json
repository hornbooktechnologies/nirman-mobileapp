{
  "expo": {
    "name": "NirmanSite",
    "slug": "nirmansite-mobile",
    "scheme": "nirmansite",
    "version": "1.0.1",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/app-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F5"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NirmanSite to select site photos for the Project diary.",
          "cameraPermission": "Allow NirmanSite to take site photos for the Project diary.",
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "hi",
              "gu"
            ],
            "android": [
              "en",
              "hi",
              "gu"
            ]
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "icon": {
        "light": "./assets/brand/app-icon.png",
        "dark": "./assets/brand/app-icon.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.nirmansite.mobile",
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "hi",
          "gu"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hornbook.nirmansite",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/app-icon.png",
        "backgroundColor": "#FAF8F5"
      }
    },
    "web": {
      "favicon": "./assets/brand/app-icon.png",
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5923f64-2d38-40c1-a31d-7cb5c69ea2db"
      }
    },
    "owner": "raxitvs-team"
  }
}
