{
  "name": "@nirman-app/mobile",
  "version": "1.0.1",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "cd ../.. && pnpm --filter @nirman-app/shared build",
    "start": "node --require ../../scripts/load-root-env.cjs ./node_modules/expo/bin/cli start",
    "start:lan": "node --require ../../scripts/load-root-env.cjs ./node_modules/expo/bin/cli start --lan --clear --max-workers 2",
    "start:tunnel": "node --require ../../scripts/load-root-env.cjs ./node_modules/expo/bin/cli start --tunnel --clear --max-workers 2",
    "android": "node --require ../../scripts/load-root-env.cjs ./node_modules/expo/bin/cli start --android",
    "ios": "node --require ../../scripts/load-root-env.cjs ./node_modules/expo/bin/cli start --ios",
    "web": "node --require ../../scripts/load-root-env.cjs ./node_modules/expo/bin/cli start --web",
    "type-check": "tsc --noEmit",
    "validate:locales": "node ./scripts/validate-locales.mjs",
    "export:android": "node --require ../../scripts/load-root-env.cjs ./node_modules/expo/bin/cli export --platform android --clear --max-workers 2",
    "release:check": "pnpm type-check && pnpm validate:locales && pnpm export:android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "15.1.1",
    "@nirman-app/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "i18next": "^26.3.6",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/metro-config": "^0.88.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.20",
    "typescript": "~6.0.3"
  }
}
