{
  "name": "@nirman-app/website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --require ../../scripts/load-root-env.cjs ./node_modules/next/dist/bin/next dev --port 3001",
    "build": "node --require ../../scripts/load-root-env.cjs ./node_modules/next/dist/bin/next build",
    "start": "node --require ../../scripts/load-root-env.cjs ./node_modules/next/dist/bin/next start",
    "type-check": "node --require ../../scripts/load-root-env.cjs ./node_modules/next/dist/bin/next typegen && tsc --noEmit",
    "screens": "python3 scripts/prepare_screens.py",
    "verify:activation": "node scripts/verify-activation.cjs",
    "verify:contact-origin": "pnpm --filter @nirman-app/api test -- --runInBand website-contact.controller.spec.ts",
    "verify:seo": "node scripts/verify-seo.cjs"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "typescript": "^5"
  }
}
