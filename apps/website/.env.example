# Server-only API base used by account activation (/activate). Keep the /api/v1 suffix.
API_BASE_URL=https://api.nirmansite.com/api/v1
# Must match WEBSITE_ENQUIRY_INGEST_KEY on the mobile API deployment.
WEBSITE_ENQUIRY_INGEST_KEY=

# Deployment URL. Set to https://nirmansite.com when launching on the live domain.
# Public metadata always points to the permanent domain, never a preview hostname.
NEXT_PUBLIC_SITE_URL=https://nirmansite.com
# Keep false on staging. Enable only for a production build serving the live domain.
# Preview/development environments and non-live SITE_URL values remain noindex.
SITE_INDEXING_ENABLED=false

# Mailbox SMTP (server-only; never prefix these with NEXT_PUBLIC_).
# The contact form stores enquiries in the Nirman API and also sends email notifications.
SMTP_HOST=mail.nirmansite.com
SMTP_PORT=587
SMTP_SECURE=false
# Your full mailbox email address.
SMTP_USER=contact@nirmansite.com
# Mailbox password. Keep blank in this example.
SMTP_PASS=
# Use the same address as SMTP_USER (or an authorized sender alias).
SMTP_FROM=contact@nirmansite.com
CONTACT_TO_EMAIL=contact@nirmansite.com
