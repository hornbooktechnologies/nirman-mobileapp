{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"],
      "env": [
        "API_BASE_URL",
        "NEXT_PUBLIC_API_BASE_PATH",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SITE_URL",
        "SITE_INDEXING_ENABLED"
      ]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},

    "type-check": {}
  }
}
