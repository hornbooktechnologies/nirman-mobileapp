# Copy this file to .env.production on the server. Never commit the real file.
ACME_EMAIL=admin@nirmansite.com

# MySQL container
MYSQL_DATABASE=nirmansite
MYSQL_USER=nirmansite
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
DATABASE_URL=mysql://nirmansite:replace-with-a-long-random-password@database:3306/nirmansite
DB_CONNECTION_LIMIT=10

# Required by the Coolify one-time migration service. The value is an explicit
# production mutation authorization; every deployment still creates a backup
# and uses the migration runner's lock and drift checks before applying SQL.
MIGRATION_APPROVED=I_UNDERSTAND_THIS_MUTATES_THE_DATABASE

# API authentication (use independent random values of at least 32 characters)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
WEBSITE_ENQUIRY_INGEST_KEY=replace-with-an-independent-random-secret
PUBLIC_WEB_APP_URL=https://app.nirmansite.com
PUBLIC_ACTIVATION_WEB_URL=https://app.nirmansite.com
MOBILE_APP_SCHEME=nirmansite

# API email fallback
API_SMTP_HOST=mail.nirmansite.com
API_SMTP_PORT=587
API_SMTP_USERNAME=contact@nirmansite.com
API_SMTP_PASSWORD=
API_SMTP_ENCRYPTION=tls
API_MAIL_FROM_ADDRESS=contact@nirmansite.com
API_MAIL_FROM_NAME=NirmanSite

# Marketing-site contact form email
WEBSITE_SMTP_HOST=mail.nirmansite.com
WEBSITE_SMTP_PORT=587
WEBSITE_SMTP_SECURE=false
WEBSITE_SMTP_USER=contact@nirmansite.com
WEBSITE_SMTP_PASS=
WEBSITE_SMTP_FROM=contact@nirmansite.com
CONTACT_TO_EMAIL=contact@nirmansite.com

# Private Gallery storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional Expo push delivery
NOTIFICATIONS_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
