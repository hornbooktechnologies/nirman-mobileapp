# Database
DATABASE_URL="mysql://user:password@localhost:3306/enterprise_app_template"

# API
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:3000"
PUBLIC_WEB_APP_URL="http://localhost:3000"
MOBILE_APP_SCHEME="nirmansite"
# Local Expo Go project origin only; leave blank for installed-app scheme links.
# Expo Go activation becomes exp://192.168.1.10:8081/--/activate?token=...
EXPO_GO_PROJECT_URL=""
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-another-32-random-characters"

# Optional SMTP fallback (platform Settings values take precedence)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_ENCRYPTION="tls"
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="NirmanSite Super Admin"

# Seed
DB_SEED_CONFIRM="enterprise_app_template"
SEED_ADMIN_EMAIL="admin@example.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ROLE_USERS="false"
SEED_ROLE_USER_EMAIL_DOMAIN="nirmansite.test"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_API_BASE_PATH="/api/v1"

# Optional storage
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
