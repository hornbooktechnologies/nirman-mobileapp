# One LOCAL configuration for API, Web, marketing Website and Mobile.
# Copy to .env at the repository root. Never commit real credentials.
# Injected process/Coolify settings take precedence. Restart after editing.

# API / database (use a local or dedicated test database)
NODE_ENV="development"
PORT="4000"
DATABASE_URL="mysql://user:password@localhost:3306/nirmansite_local"
DB_CONNECTION_LIMIT="5"
FRONTEND_URL="http://localhost:3000,http://localhost:8081"
JWT_SECRET="replace-with-an-independent-random-secret-of-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-another-independent-random-secret-of-at-least-32-characters"
# Optional legacy server-to-server ingest endpoint; unused by the public form.
WEBSITE_ENQUIRY_INGEST_KEY=""

# Public phone/email links use the live app; issuing API and recipient app must share backing data.
PUBLIC_WEB_APP_URL="https://app.nirmansite.com"
PUBLIC_ACTIVATION_WEB_URL="https://app.nirmansite.com"
MOBILE_APP_SCHEME="nirmansite"
# For Expo Go activation testing: exp://YOUR_PC_LAN_IP:8081
# Leave empty for installed-app links.
EXPO_GO_PROJECT_URL=""

# API mail fallback; saved platform Email Settings take precedence.
API_SMTP_HOST="mail.nirmansite.com"
API_SMTP_PORT="465"
API_SMTP_USERNAME="contact@nirmansite.com"
API_SMTP_PASSWORD=""
API_SMTP_ENCRYPTION="ssl"
API_MAIL_FROM_ADDRESS="contact@nirmansite.com"
API_MAIL_FROM_NAME="NirmanSite"

# Customer Web: localhost:3000, same-origin API proxy
NEXT_PUBLIC_API_BASE_PATH="/api/v1"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Marketing Website: localhost:3001
API_BASE_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
SITE_INDEXING_ENABLED="false"
CONTACT_TO_EMAIL="contact@nirmansite.com"

# Mobile dev resolver maps localhost to the Metro LAN host on a phone.
EXPO_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
NOTIFICATIONS_PUSH_ENABLED="true"
EXPO_ACCESS_TOKEN=""

# Private Gallery / assets
AWS_REGION="us-east-2"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Optional seed/deployment settings. No migration or seed is run by startup.
SEED_ADMIN_EMAIL="admin@example.local"
SEED_ADMIN_PASSWORD=""
ACME_EMAIL=""
MYSQL_DATABASE=""
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_ROOT_PASSWORD=""
MIGRATION_APPROVED=""

# Exact public marketing origin accepted by the API contact endpoint
WEBSITE_URL="http://localhost:3001"
