# Store the real file outside the repository with mode 600.
COOLIFY_API_URL=https://coolify.example.com
COOLIFY_AUTH_HEADER_FILE=/home/hornbook/.config/nirmansite-coolify/authorization.header

GIT_REPOSITORY=git@github.com:hornbooktechnologies/nirman-mobileapp.git
GIT_BRANCH=main
GIT_CACHE_DIR=/home/hornbook/.local/state/nirmansite-coolify/repository.git
DEPLOYED_SHA_FILE=/home/hornbook/.local/state/nirmansite-coolify/deployed.sha
LOCK_FILE=/home/hornbook/.local/state/nirmansite-coolify/poller.lock

# UUIDs of the three Git-based Docker Compose applications in Coolify.
COOLIFY_API_APPLICATION_UUID=replace-with-api-application-uuid
COOLIFY_WEB_APPLICATION_UUID=replace-with-web-application-uuid
COOLIFY_WEBSITE_APPLICATION_UUID=replace-with-website-application-uuid

# During rollback to the former aggregate application, remove the three values
# above and set this legacy UUID instead.
# COOLIFY_APPLICATION_UUID=replace-with-legacy-application-uuid
