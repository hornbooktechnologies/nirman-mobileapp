{
  "name": "nirman-app",
  "version": "1.0.0",
  "description": "NirmanSite application monorepo",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @nirman-app/shared build && turbo dev",
    "mobile:lan": "pnpm --filter @nirman-app/mobile start:lan",
    "mobile:tunnel": "pnpm --filter @nirman-app/mobile start:tunnel",
    "mobile:release:check": "pnpm --filter @nirman-app/mobile release:check",
    "website:dev": "pnpm --filter @nirman-app/website dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "db:migrate": "pnpm --filter @nirman-app/api db:migrate",
    "db:migrate:status": "pnpm --filter @nirman-app/api db:migrate:status",
    "db:seed": "pnpm --filter @nirman-app/api db:seed",
    "docker:config": "docker compose --env-file .env.production config",
    "docker:build": "docker compose --env-file .env.production build"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "latest"
  },
  "packageManager": "pnpm@11.28.6"
}
